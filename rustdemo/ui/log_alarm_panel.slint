// Bottom log / alarm panel.
import { Button, VerticalBox, HorizontalBox, ListView, CheckBox } from "std-widgets.slint";
import { LogRow, AlarmRow } from "app_state.slint";

export component LogAlarmPanel inherits Rectangle {
    height: 130px;
    in-out property <int> active: 0;
    in-out property <[LogRow]> logs: [];
    in-out property <[AlarmRow]> alarms: [];
    callback clear_logs(); callback save_logs(); callback test_event();
    VerticalLayout { padding: 4px; spacing: 4px;
        HorizontalLayout { spacing: 8px;
            CheckBox { text: "Local log"; checked: active == 0; toggled => { active = 0; } }
            CheckBox { text: "Alarm info"; checked: active == 1; toggled => { active = 1; } }
            Button { text: "Clean"; clicked => { clear_logs(); } }
            Button { text: "Save"; clicked => { save_logs(); } }
            Button { text: "Test"; clicked => { test_event(); } }
        }
        Rectangle { height: 88px; background: #fff; border-color: #ccc; border-width: 1px;
            if active == 0: ListView {
                for row in logs: HorizontalLayout { height: 18px; Text { text: row.time; width: 140px; } Text { text: row.interface; width: 160px; } Text { text: row.device_ip; width: 120px; } Text { text: row.info; color: row.success ? #2c8a3a : #b00020; } }
            }
            if active == 1: ListView {
                for row in alarms: HorizontalLayout { height: 18px; Text { text: row.time; width: 140px; } Text { text: row.alarm_type; width: 160px; } Text { text: row.device; width: 200px; } Text { text: row.info; } }
            }
        }
    }
}
